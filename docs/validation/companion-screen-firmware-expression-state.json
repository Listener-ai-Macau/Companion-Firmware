  "sources": {
    "display_queue": "app/companion_pendant/epaper/display_queue.c",
    "firmware_event_bridge": "app/companion_pendant/epaper/expression_events.c",
    "firmware_header": "app/companion_pendant/epaper/expression_state.h",
    "firmware_source": "app/companion_pendant/epaper/expression_state.c",
    "policy": "app/companion_pendant/epaper/expression_policy.py",
