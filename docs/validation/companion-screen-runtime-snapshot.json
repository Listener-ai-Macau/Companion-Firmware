  },
  "sources": {
    "epaper_readme": "app/companion_pendant/epaper/README.md",
    "screen_acceptance": "docs/companion_screen_expression_system.md",
    "screen_runtime_header": "app/companion_pendant/epaper/screen_runtime.h",
    "screen_runtime_source": "app/companion_pendant/epaper/screen_runtime.c",
    "wb55_build": "cubeide/Companion_Nucleo_WB55RG_Bringup/Makefile",
    "wb55_integration": "cubeide/Companion_Nucleo_WB55RG_Bringup/Core/Src/app_ble.c",
    "wba_rules": "docs/stm32wba_migration_rules.md"
  },
  "status": "PASS",
  "validation_commands": [
    "python .\\tools\\verify_expression_screen_runtime_snapshot.py",
    "python .\\tools\\verify_expression_state_telemetry.py",
    "python .\\tools\\verify_display_queue_telemetry.py",
    "python .\\tools\\verify_expression_panel_adapter_telemetry.py",
    "python .\\tools\\verify_display_queue_static.py",
